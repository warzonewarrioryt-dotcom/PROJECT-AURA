# =========================================================
# PROJECT AURA 3.0 — ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to '.env' inside the 'backend/' directory (or project root).
# Never commit your real '.env' file with actual API keys to GitHub.
# =========================================================

# --- Server Ports & URLs ---
PORT=3000
PYTHON_ENGINE_URL=http://127.0.0.1:5050

# --- Primary Provider: Google Gemini (Priority Engine) ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# --- Groq AI (Ultra-fast LLM Inference) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- OpenAI (GPT-4o Multi-step Logic & Tools) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- NVIDIA NIM (Cloud Microservices & Fallback LLM) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Hugging Face (Open-Weights Endpoint Models) ---
HF_TOKEN=your_huggingface_access_token_here
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# --- Tavily (Autonomous Deep Web Search) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- ElevenLabs (Cinematic Human Speech & Neural Audio) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- YouTube Data API v3 (Lecture & Educational Video Indexing) ---
YOUTUBE_API_KEY=your_google_youtube_api_key_here
